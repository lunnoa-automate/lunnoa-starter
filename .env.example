# Base URL of your Lunnoa Automate deployment.
# The app signs people in as Lunnoa users in the browser.
# Add this app's URL to CORS_ALLOWED_ORIGINS on the deployment.
LUNNOA_URL=https://lunnoa.your-company.example

# Workspace API key (lna_...) for CLI only: discovery, codegen, status, pull, push and deploy.
# status and pull work with a read-only key; push and deploy need one that can create
# workflows and agents. The running app does not use this key. Never prefix it with NEXT_PUBLIC_.
LUNNOA_API_KEY=
