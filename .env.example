# Base URL of your Lunnoa Automate deployment.
LUNNOA_URL=https://lunnoa.your-company.example

# server = the app's backend holds an API key (your app has its own users, or none).
# user   = people sign in with their Lunnoa account in the browser.
#          Ask your Lunnoa admin to add this app's URL to CORS_ALLOWED_ORIGINS.
LUNNOA_AUTH_MODE=server

# Workspace API key (lna_...) from Adminspace -> API keys. Server-side only:
# never rename it to NEXT_PUBLIC_* or use it in browser code.
# Also used by `npx lunnoa-client ...` discovery and deploy commands.
LUNNOA_API_KEY=

# Project UUID for `npx lunnoa-client workflows|agents deploy` (see `npx lunnoa-client projects list`).
LUNNOA_PROJECT_ID=
